{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/Antonin1106/WSync-LED/main/src/config/wsync-led.schema.json",
    "title": "WSync-LED Configuration",
    "description": "Configuration file for WSync-LED.",
    "type": "object",
    "required": [
        "wsync-led-settings-v1",
        "wsync-led-overrides-v1"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Schema version.",
            "default": "wsync-led.schema.json"
        },
        "wsync-led-settings-v1": {
            "type": "object",
            "description": "Application settings.",
            "additionalProperties": false,
            "properties": {
                "ip": {
                    "type": "string",
                    "description": "IP address or hostname of the LED controller.",
                    "default": ""
                },
                "path": {
                    "type": "string",
                    "description": "WebSocket endpoint path.",
                    "default": "ws"
                },
                "fps": {
                    "type": "number",
                    "description": "Target refresh rate in frames per second.",
                    "minimum": 5,
                    "maximum": 60,
                    "default": 24
                },
                "leds": {
                    "type": "number",
                    "description": "Total number of LEDs.",
                    "minimum": 1,
                    "maximum": 1600,
                    "default": 150
                },
                "ledX": {
                    "type": "number",
                    "description": "Number of LEDs on the horizontal axis.",
                    "minimum": 1,
                    "maximum": 40,
                    "default": 15
                },
                "ledY": {
                    "type": "number",
                    "description": "Number of LEDs on the vertical axis.",
                    "minimum": 1,
                    "maximum": 40,
                    "default": 10
                },
                "mappingMode": {
                    "type": "string",
                    "description": "LED mapping algorithm.",
                    "enum": [
                        "grid",
                        "perimeter",
                        "border"
                    ],
                    "default": "grid"
                },
                "gain": {
                    "type": "number",
                    "description": "Brightness gain multiplier.",
                    "minimum": 0.2,
                    "maximum": 4,
                    "multipleOf": 0.05,
                    "default": 1.3
                },
                "smooth": {
                    "type": "number",
                    "description": "Smoothing factor.",
                    "minimum": 0,
                    "maximum": 0.95,
                    "multipleOf": 0.01,
                    "default": 0.35
                },
                "threshold": {
                    "type": "number",
                    "description": "Minimum color difference required before updating LEDs.",
                    "minimum": 0,
                    "maximum": 80,
                    "default": 8
                },
                "gamma": {
                    "type": "number",
                    "description": "Gamma correction factor.",
                    "minimum": 1,
                    "maximum": 3.4,
                    "multipleOf": 0.05,
                    "default": 2
                },
                "saturation": {
                    "type": "number",
                    "description": "Color saturation multiplier.",
                    "minimum": 0,
                    "maximum": 2.5,
                    "multipleOf": 0.05,
                    "default": 1
                },
                "reverse": {
                    "type": "boolean",
                    "description": "Reverse the LED order.",
                    "default": false
                },
                "lang": {
                    "type": "string",
                    "description": "Application language.",
                    "enum": [
                        "en",
                        "fr"
                    ],
                    "default": "en"
                },
                "autoCompute": {
                    "type": "boolean",
                    "description": "Automatically compute the LED layout.",
                    "default": true
                },
                "computeExactLedCount": {
                    "type": "boolean",
                    "description": "Compute the exact number of LEDs based on the selected layout.",
                    "default": false
                },
                "protocol": {
                    "type": "string",
                    "description": "Communication protocol used to send LED data.",
                    "enum": [
                        "ddp",
                        "JSON"
                    ],
                    "default": "ddp"
                },
                "dataType": {
                    "type": "string",
                    "description": "Pixel data format.",
                    "enum": [
                        "RGB",
                        "RGBW"
                    ],
                    "default": "RGB"
                }
            }
        },
        "wsync-led-overrides-v1": {
            "type": "object",
            "description": "Per-LED color overrides indexed by LED number.",
            "patternProperties": {
                "^[0-9]+$": {
                    "type": "object",
                    "description": "Override configuration for a single LED.",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Whether the override is enabled.",
                            "default": true
                        },
                        "color": {
                            "type": "string",
                            "description": "Override color in hexadecimal format (#RRGGBB).",
                            "pattern": "^#[0-9A-Fa-f]{6}$"
                        }
                    }
                }
            },
            "additionalProperties": false,
            "default": {}
        }
    }
}